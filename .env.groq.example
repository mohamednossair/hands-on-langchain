# ── Hands-On LangChain — Groq environment variables ──────────────────────
# Copy this file to `.env`; the notebooks auto-load it.

# Select Groq for chat.
MODEL_PROVIDER=groq

# Groq chat model.
GROQ_MODEL=openai/gpt-oss-120b
# Add your own key to the ignored `.env` after copying this template.
# Create a key at https://console.groq.com/keys.
# GROQ_API_KEY=your-groq-api-key-here

# Embeddings remain local Ollama when Groq is selected.
#   ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
# Optional; Ollama defaults to http://localhost:11434.
# OLLAMA_BASE_URL=http://localhost:11434

# REQUIRED for the search agent (Ch 14, Part III)
TAVILY_API_KEY=tvly-...

# OPTIONAL — LangSmith tracing / "observing behind the scenes" (Ch 6)
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
