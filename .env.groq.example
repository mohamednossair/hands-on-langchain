# ── Hands-On LangChain — Groq environment variables ──────────────────────
# Copy this file to `.env`; the notebooks auto-load it.

# Select Groq for chat.
MODEL_PROVIDER=groq

# Groq chat model.
GROQ_MODEL=openai/gpt-oss-20b
# Add your own key to the ignored `.env` after copying this template.
# Create a key at https://console.groq.com/keys.
GROQ_API_KEY=

# Embeddings now use sentence-transformers (local CPU-friendly).
# Model: sentence-transformers/all-mpnet-base-v2 (768 dimensions)
# No need to pull Ollama embedding models anymore.
# EMBEDDING_MODEL=nomic-embed-text  # Legacy Ollama setting (no longer used)
# Optional; Ollama defaults to http://localhost:11434.
# OLLAMA_BASE_URL=http://localhost:11434

# REQUIRED for the search agent (Ch 14, Part III)
TAVILY_API_KEY=tvly-...

# OPTIONAL — LangSmith tracing / "observing behind the scenes" (Ch 6)
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
