# ── Hands-On LangChain — environment variables ───────────────────────────
# Copy this file to `.env` and fill in your keys. The notebooks auto-load it.

# REQUIRED — used in almost every chapter (chat models + embeddings)
OPENAI_API_KEY=sk-...

# The chat model the whole book uses. Change here once to swap everywhere.
MODEL=gpt-5.4-mini
# Embedding model for the RAG chapters (Part II)
EMBEDDING_MODEL=text-embedding-3-small

# REQUIRED for the search agent (Ch 14, Part III)
TAVILY_API_KEY=tvly-...

# OPTIONAL — LangSmith tracing / "observing behind the scenes" (Ch 6)
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
