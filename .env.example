# ── Hands-On LangChain — environment variables ───────────────────────────
# Copy this file to `.env`; the notebooks auto-load it.

# Ollama must be installed and running locally. Pull the models below before
# running notebooks; qwen2.5 supports the structured-output and tool examples.
#   ollama pull qwen2.5:7b
#   ollama pull nomic-embed-text

# Shared chat and embedding model identifiers. Change here to switch models.
MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
# Optional; Ollama defaults to http://localhost:11434.
# OLLAMA_BASE_URL=http://localhost:11434

# REQUIRED for the search agent (Ch 14, Part III)
TAVILY_API_KEY=tvly-...

# OPTIONAL — LangSmith tracing / "observing behind the scenes" (Ch 6)
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
